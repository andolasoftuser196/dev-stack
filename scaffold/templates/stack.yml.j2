# stack.yml - the declarative shape of this project's dev environment.
#
# Generated by `dx init` from what was found in the repository. The detection is
# a starting point, not an answer: check runtime.docroot, services.database and
# hooks.postStart before trusting it.
#
# Commit this file. Machine-local things - ports, bind address, secrets - belong
# in .env, which is not committed.

name: {{ name }}
domain: {{ domain }}

repo:
  root: {{ repo_root }}
  git_root: {{ git_root }}
  worktree_root: {{ worktree_root }}

runtime:
  kind: {{ runtime }}
  version: "{{ version }}"
  framework: {{ framework }}
  docroot: {{ docroot }}
  port: 80
  app_port: {{ app_port }}
  healthz: {{ healthz }}
  packages: []

services:
  database: {{ database }}
  cache: {{ cache }}
  mail: mailpit
  storage: minio
  search: none
  queue: {{ 'true' if queue else 'false' }}
  scheduler: {{ 'true' if scheduler else 'false' }}
  vector: none

database:
  name: {{ db_name }}
  user: {{ db_user }}
  password: {{ db_user }}
  version: "{{ db_version }}"

routes:
  app: app
  optional: [mail, db, cache, s3, minio, vnc, mcp]

tools:
  db_ui: true
  cache_ui: true
  browser: true
  mcp: true

# Lifecycle hooks, in the devcontainer sense. postCreate runs once per created
# container; postStart runs on every start. Keeping the slow one in postCreate is
# the difference between a 40-second boot and a 4-second one.
hooks:
  # Dependencies are not listed here: `dx up` installs them through the runtime
  # module, which knows the right command and what to do when there is no
  # lockfile yet. Put project-specific one-time setup here.
  postCreate: []
  postStart:
{% for h in post_start %}
    - "{{ h }}"
{% endfor %}
{% if not post_start %}
    []
{% endif %}
  preDown: []
  postInstance:
{% for h in post_instance %}
    - "{{ h }}"
{% endfor %}
{% if not post_instance %}
    []
{% endif %}

agents:
  max_concurrent: 4
  cpus: "2.0"
  memory: "4g"
  pids_limit: 512
  lease_ttl: "4h"
  egress: allowlist
