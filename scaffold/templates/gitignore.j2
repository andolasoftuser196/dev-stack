# Machine-local and runtime state. Everything here is regenerated by ssmd.

# Secrets and per-machine settings.
.env
.env.local

# Compiled from stack.yml on demand.
.stack.env

# All runtime state: database files, the local CA, caches, container profiles,
# agent home directories. Never commit any of it - data/proxy alone contains a
# private key, and data/agent/ contains whatever an agent downloaded.
data/

# Snapshots are the exception people ask about: they live under data/ and are
# deliberately gitignored too. They are database dumps of a dev environment,
# which is exactly the kind of thing that turns out to contain a real customer
# record six months later.

# Scaffolding venv, created on first `ssmd init`.
scaffold/.venv/
__pycache__/
*.pyc

# Local compose overrides.
docker-compose.override.yml
