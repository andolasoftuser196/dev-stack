{
  "name": "dx/demo-cakephp",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "cakephp/cakephp": "^5.0",
    "cakephp/migrations": "^4.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.1",
    "cakephp/cakephp-codesniffer": "^5.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Test\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
