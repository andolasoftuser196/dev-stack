# Laravel reads APP_KEY from here, and ssmd deliberately does not set it.
#
# An imported database's encrypted columns were encrypted under a particular
# key; changing it makes every read of them throw DecryptException, which looks
# nothing like a key problem. Generate it once and then leave it alone:
#
#   ssmd run 'php artisan key:generate'
#
# Everything else - DB_*, REDIS_*, MAIL_* - is injected by ssmd as process
# environment, which beats this file. Editing those here does nothing.
APP_NAME=ssmd-demo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
