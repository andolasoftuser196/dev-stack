# A fixed APP_KEY, committed on purpose.
#
# Laravel's `web` middleware group encrypts cookies and starts a session, so a
# missing APP_KEY is a 500 on every request — with a debug page that does say so,
# but only if you can read HTML out of a curl.
#
# Committing a key is safe here and only here: this is a throwaway demo with no
# data. A real project generates its own and never commits it, because an
# imported database's encrypted columns are tied to whichever key encrypted them.
APP_NAME=ssmd-demo
APP_ENV=local
APP_KEY=base64:HP1ThQWg25Kmvt8FiDUs1467ZHd08DQSnWH99mBTU84=
APP_DEBUG=true

# Everything else — DB_*, REDIS_*, MAIL_*, and the driver names — is injected by
# ssmd as process environment, which wins over this file.
